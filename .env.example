# Скопируйте в .env и заполните. Файл .env никогда не коммитьте — в нём ключи.

# Где торговать: paper — бумажный счёт без ключей; demo — демо-счёт Bybit (api-demo.bybit.com);
# testnet — тестовая сеть; mainnet — РЕАЛЬНЫЕ деньги.
BYBIT_ENV=paper
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Свой адрес API, если аккаунт региональный (например https://api.bybit.kz). Обычно пусто.
BYBIT_BASE_URL=

# Реальный счёт Bybit. Ключ без вывода, с привязкой к IP сервера: «только чтение» — баланс, активы и ордера
# видны, сделок и бота нет; со «Спот — торговля» — ещё ручные сделки и бот (включается отдельно, с капиталом).
# Когда реальный счёт подключён, демо-счёт в приложении скрыт и бот на нём не торгует;
# вернуть демо рядом с реальным — OWNER_DEMO=1.
BYBIT_REAL_API_KEY=
BYBIT_REAL_API_SECRET=
OWNER_DEMO=0

# Раздел «Фьючерсы» рядом со спотом на том же счёте Bybit (1 — включить). Для копитрейдинга: Bybit копирует
# подписчикам только фьючерсы USDT. Бот там только покупает (лонг) с плечом 1x и не больше своих денег — по риску
# как спот; только пары из копитрейдинга; ручные сделки в разделе отключены. Кошелёк общий со спотом, поэтому
# бот фьючерсов выключен, пока в приложении не задан его капитал. Ключу нужно право «Контракты — ордера и позиции».
BYBIT_FUTURES=0

# «Мои биржи»: балансы на всех ваших биржах и где закрыт ввод/вывод монет — только просмотр.
# Ключи ТОЛЬКО ДЛЯ ЧТЕНИЯ (Binance: «Enable Reading»; OKX: Read; KuCoin: General), с привязкой к IP сервера.
# Ключ с правом торговли или вывода бот не примет. Bybit берётся из ключа реального счёта (BYBIT_REAL_API_KEY).
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=
KUCOIN_API_KEY_VERSION=3

# «Цена на биржах» в карточке монеты — из CoinGecko, без ключей бирж. Без ключа лимит запросов маленький;
# бесплатный demo-ключ (coingecko.com → Developers → Demo API) поднимает его. Необязательно.
COINGECKO_API_KEY=

# P2P Bybit владельца (1 — включить): спред USDT по вашим способам оплаты, ваши ордера, статистика и уведомления
# в Telegram («покупатель отметил оплату — проверьте банк и отпустите вручную»). Только просмотр: бот ничего не
# покупает, не продаёт и не отпускает монеты. P2P API Bybit открыт только рекламодателям (General Advertiser и выше).
# Ключ — реального счёта с правами P2P «Ордера» и «Объявления» (просмотр) или отдельный BYBIT_P2P_API_KEY.
BYBIT_P2P=0
BYBIT_P2P_API_KEY=
BYBIT_P2P_API_SECRET=
P2P_CURRENCIES=RUB,USD

# signals — только сигналы; confirm — сделка после нажатия «Купить»; auto — бот торгует сам.
MODE=confirm

# Сколько USDT отдано боту (0 — весь свободный USDT на счёте).
BOT_CAPITAL_USDT=0
RISK_PCT=0.3
MAX_POSITIONS=25
MAX_POSITION_PCT=25
MAX_TOTAL_RISK_PCT=10
DAILY_LOSS_LIMIT_PCT=3
# новые сделки — только когда BTC выше средней за BTC_DAYS дней (проверка: scripts/context_study.py)
BTC_FILTER=1
BTC_DAYS=50
# входить только в монеты, которые выросли за TREND_DAYS дней (проверка: scripts/portfolio_study.py)
TREND_FILTER=1
TREND_DAYS=120
PROPOSAL_TTL_MIN=60
# COINS=BTC,ETH,SOL

# Telegram: токен от @BotFather и ваш chat id (ваш счёт; остальные пользователи — только демо-счета, см. ниже).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Доступ Android-приложения. DOMAIN по умолчанию — <IP-сервера>.sslip.io (HTTPS без покупки домена).
API_TOKEN=
DOMAIN=

# Ежедневная сводка в Telegram (меняется и в мини-приложении → «Настройки»)
DAILY_REPORT=1
REPORT_HOUR_UTC=7

# Демо-счета для всех: любой пользователь Telegram по /start или при входе в приложение получает
# свой бумажный счёт (PAPER_START_USDT виртуальных USDT), бот торгует на нём сам. 0 — только владелец.
PUBLIC_DEMO=1
MAX_USERS=100
