# Скопируйте в .env и заполните. Файл .env никогда не коммитьте — в нём ключи.

# Где торговать: paper — бумажный счёт без ключей; demo — демо-счёт Bybit (api-demo.bybit.com);
# testnet — тестовая сеть; mainnet — РЕАЛЬНЫЕ деньги.
BYBIT_ENV=paper
BYBIT_API_KEY=
BYBIT_API_SECRET=
# Свой адрес API, если аккаунт региональный (например https://api.bybit.kz). Обычно пусто.
BYBIT_BASE_URL=

# Реальный счёт Bybit — второй счёт рядом с демо, переключается в приложении («Главная» → счёт).
# Ключ: только «Спот — торговля», без вывода, с привязкой к IP сервера. Бот на нём по умолчанию
# выключен: включается в приложении, после того как задан его капитал. Ручные сделки — сразу.
BYBIT_REAL_API_KEY=
BYBIT_REAL_API_SECRET=

# Рынок: spot — спот; linear — фьючерсы USDT для копитрейдинга Bybit (подписчики копируют только фьючерсы).
# На фьючерсах бот только покупает (лонг) с плечом 1x и не больше своих денег — по риску как спот;
# торгует только парами, доступными в копитрейдинге; ручные сделки на таком счёте отключены.
# Ключу нужно право «Контракты — ордера и позиции». Проверять — сначала на демо: BYBIT_ENV=demo, BYBIT_MARKET=linear.
BYBIT_MARKET=spot
BYBIT_REAL_MARKET=spot

# signals — только сигналы; confirm — сделка после нажатия «Купить»; auto — бот торгует сам.
MODE=confirm

# Сколько USDT отдано боту (0 — весь свободный USDT на счёте).
BOT_CAPITAL_USDT=0
RISK_PCT=0.3
MAX_POSITIONS=25
MAX_POSITION_PCT=25
MAX_TOTAL_RISK_PCT=10
DAILY_LOSS_LIMIT_PCT=3
# новые сделки — только когда BTC выше средней за BTC_DAYS дней (проверка: scripts/context_study.py)
BTC_FILTER=1
BTC_DAYS=50
# входить только в монеты, которые выросли за TREND_DAYS дней (проверка: scripts/portfolio_study.py)
TREND_FILTER=1
TREND_DAYS=120
PROPOSAL_TTL_MIN=60
# COINS=BTC,ETH,SOL

# Telegram: токен от @BotFather и ваш chat id (ваш счёт; остальные пользователи — только демо-счета, см. ниже).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Доступ Android-приложения. DOMAIN по умолчанию — <IP-сервера>.sslip.io (HTTPS без покупки домена).
API_TOKEN=
DOMAIN=

# Ежедневная сводка в Telegram (меняется и в мини-приложении → «Настройки»)
DAILY_REPORT=1
REPORT_HOUR_UTC=7

# Демо-счета для всех: любой пользователь Telegram по /start или при входе в приложение получает
# свой бумажный счёт (PAPER_START_USDT виртуальных USDT), бот торгует на нём сам. 0 — только владелец.
PUBLIC_DEMO=1
MAX_USERS=100
